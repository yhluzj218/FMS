import base64

def decrypt(ciphertext_str, key_str):
    # 解碼 Base64 密文
    ciphertext_bytes = base64.b64decode(ciphertext_str)
    # 將 Key 轉為 bytes
    key_bytes = key_str.encode('utf-8')
    key_len = len(key_bytes)
    # 進行 XOR 解密還原
    decrypted_bytes = bytes(b ^ key_bytes[i % key_len] for i, b in enumerate(ciphertext_bytes))
    
    return decrypted_bytes.decode('utf-8')
# --- 執行解密 ---
secret_text = "KiJOjvTjuC7yiNj6iffW"
my_key = "ZoningPM"

original_text = decrypt(secret_text, my_key)
print("解密後的中文內容：", original_text)
